# ─────────────────────────────────────────────────────────────
# Contact form delivery. Set either or both — the form succeeds
# if at least one channel goes through.
# ─────────────────────────────────────────────────────────────

# 1) EMAIL via Resend  →  https://resend.com
#    Sign up → API Keys → Create (free tier: 3k emails/month).
RESEND_API_KEY=

#    Optional. CONTACT_FROM needs a domain you've verified in Resend;
#    leave unset to send from onboarding@resend.dev.
# CONTACT_FROM="Portfolio <hello@srithings.info>"
# CONTACT_TO="mastersk0210@gmail.com"

# 2) TELEGRAM  (recommended — reliable, 1-min setup)
#    a. In Telegram, message @BotFather → /newbot → follow prompts → copy the token.
#    b. Message your new bot anything (say "hi").
#    c. Open  https://api.telegram.org/bot<TOKEN>/getUpdates  → copy "chat":{"id": ... }.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3) WHATSAPP via CallMeBot  (optional — free but a flaky relay)
#    On your PHONE open:
#    https://wa.me/34644442107?text=I%20allow%20callmebot%20to%20send%20me%20messages
#    Send it → CallMeBot replies with your apikey.
CALLMEBOT_APIKEY=

#    Your number, digits only, with country code (defaults to the one in the code).
# WHATSAPP_TO=353894002480
